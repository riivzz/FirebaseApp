<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <!-- Título de bienvenida de la pantalla principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Bienvenid@"
        android:textColor="#333333"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Botón para la opción de Crear registros -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrear"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6750A4"
        android:text="Nuevo"
        android:textAllCaps="false"
        app:cornerRadius="28dp" />

    <!-- Botón para la opción de Buscar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuscar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6750A4"
        android:text="Buscar"
        android:textAllCaps="false"
        app:cornerRadius="28dp" />

    <!-- Botón para la opción de Modificar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModificar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6750A4"
        android:text="Modificar"
        android:textAllCaps="false"
        app:cornerRadius="28dp" />

    <!-- Botón para la opción de Borrar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBorrar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6750A4"
        android:text="Borrar"
        android:textAllCaps="false"
        app:cornerRadius="28dp" />

    <!-- Botón para cerrar sesión y regresar al login -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#6750A4"
        android:text="Cerrar Sesión"
        android:textAllCaps="false"
        app:cornerRadius="28dp" />

</LinearLayout>