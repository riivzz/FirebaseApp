<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:layout_marginBottom="24dp"
            android:text="Borrar Registro"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="DNI a borrar"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDelDni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelBuscar"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:backgroundTint="#6750A4"
                android:text="Buscar"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <!-- Datos a borrar (texto estático) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFEBEB"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView android:id="@+id/tvDelNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre: " android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvDelApellidos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apellidos: " android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvDelMascota" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mascotas preferidas: " />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelBorrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#B3261E"
            android:text="Eliminar Definitivamente"
            android:textAllCaps="false"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>