<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Elige tu mascota"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />

   <!-- Primera Fila: Perro y Gato -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <!-- Perro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPerro"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/perro" />

            <CheckBox
                android:id="@+id/cbPerro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Gato -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgGato"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/gato" />

            <CheckBox
                android:id="@+id/cbGato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
    </LinearLayout>
        </LinearLayout>

        <!-- Segunda Fila: Pájaro (Izquierda) y Pez (Derecha) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal">

            <!-- Columna Pájaro -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgPajaro"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pajaro" />

                <CheckBox
                    android:id="@+id/cbPajaro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Columna Pez -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgPez"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pez" />

                <CheckBox
                    android:id="@+id/cbPez"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón de confirmación -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarMascota"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#6750A4"
            android:text="Confirmar elección"
            android:textAllCaps="false"
            app:cornerRadius="28dp" />


</LinearLayout>